#include <stdio.h>
#include <stdlib.h>

int main(void)
{
    // list of size 3
    int *list = malloc(3 * sizeof(int));
    if (list == NULL)
    {
        return 1;
    }
    // initalize list of size 3 witn numbers
    list[0] = 1;
    list[1] = 2;
    list[2] = 3;

    // list of size 4
    int *temp = malloc(4 * sizeof(int));
    if (temp == NULL)
    {
        free(list);
        return 1;
    }

    // copy list of size 3 into list of size 4
    for (int i = 0; i < 3; i++)
    {
        temp[i] = list[i];
    }
    // Add number to list of size 4
    temp[3] = 4;
    // free list of size 4
    free(list);
    // Remember list of size 4
    list = temp;

    // print list
    for (int i = 0; i < 4; i++)
    {
        printf("%i\n", list[i]);
    }
    // Free list
    free(list);
    return 0;
}

